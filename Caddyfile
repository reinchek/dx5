# ──────────────────────────────────────────────
# dx5 + Caddy — automatic HTTPS reverse proxy
# ──────────────────────────────────────────────
# Replace `your-blog.com` with your actual domain.
# Caddy will auto-provision Let's Encrypt certificates.
#
# For local development, use `:80` instead of a domain:
#   :80 { reverse_proxy dx5:8000 }
# ──────────────────────────────────────────────

your-blog.com {
    reverse_proxy dx5:8000
}
