# ──────────────────────────────────────────────
# dx5 + Caddy — reverse proxy
# ──────────────────────────────────────────────
# Local dev (HTTPS via Caddy internal CA):
#   https://localhost
#
# Production (automatic HTTPS via Let's Encrypt):
#   Uncomment the production block below,
#   replace `your-blog.com` with your domain,
#   and comment out the local block.
# ──────────────────────────────────────────────

# Local development
:8080 {
    tls internal
    reverse_proxy dx5:8000
}
# Local development - self-signed HTTPS
localhost {
    tls internal
    reverse_proxy dx5:8000
}
# Production - automatic HTTPS (Let's Encrypt)
# your-blog.com {
#     reverse_proxy dx5:8000
# }
