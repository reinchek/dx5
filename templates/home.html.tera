{% extends "base" %}

{% block title %}{{ app.title }} // Home{% endblock title %}
{% block description %}{{ app.title }} — developer log{% endblock description %}

{% block content %}

    {# HERO #}
    <section class="mb-16 pt-4">

        {# Terminal prefix #}
        <div class="text-[#00e5a0] text-xs tracking-widest mb-3 uppercase">
            <span class="text-zinc-600">$</span> cat home.{{ lang }}.yaml
        </div>

        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter text-zinc-100 leading-none mb-4">
            {% if item.body_fields %}
                {% for field in item.body_fields %}
                    {% if field.type == "hero_title" %}
                        <span class="glitch" data-glitch="{{ field.value_glitch | default(value=field.value) }}">
                        {{ field.value }}
                    </span>
                    {% endif %}
                {% endfor %}
            {% else %}
                <span class="glitch" data-glitch="{{ app.title }}">{{ app.title }}</span>
            {% endif %}
        </h1>

        {% if item.intro %}
            <p class="text-zinc-400 text-sm max-w-xl leading-relaxed border-l-2 border-[#00e5a0]/40 pl-4 mt-6">
                {{ item.intro }}
            </p>
        {% endif %}

    </section>

    {# BODY FIELDS (home contents) #}
    {% if item.body_fields %}
        <section class="mb-16 space-y-6">
            {% for field in item.body_fields %}
                {% if field.type != "hero_title" %}
                    {{ render_field(field=field, type=field.type) | safe }}
                {% endif %}
            {% endfor %}
        </section>
    {% endif %}

    {# Content types link section #}
    <section>
        <div class="text-[10px] text-zinc-600 tracking-widest uppercase mb-6">// {{ t(key="text__explore", lang=lang) }}</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {% for item in menu_items %}
                <a data-spa href="/{{ lang }}{{ item.path }}"
                   class="group border border-zinc-800 hover:border-[#00e5a0]/50 bg-zinc-900/40 hover:bg-zinc-900/80
                  p-5 transition-all duration-200 flex items-center gap-4">
                    {% if item.icon %}
                        <span class="text-xl text-zinc-600 group-hover:text-[#00e5a0] transition-colors">
                <i class="{{ item.icon }}"></i>
            </span>
                    {% endif %}
                    <div>
                        <div class="text-sm font-semibold text-zinc-200 group-hover:text-[#00e5a0] transition-colors tracking-wider">
                            {{ item.label }}
                        </div>
                        <div class="text-[11px] text-zinc-600 mt-0.5 tracking-wider">/{{ lang }}{{ item.path }}</div>
                    </div>
                    <span class="ml-auto text-zinc-700 group-hover:text-[#00e5a0] text-xs transition-colors">→</span>
                </a>
            {% endfor %}
        </div>
    </section>

{% endblock content %}
