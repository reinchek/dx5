{% extends "base" %}

{% block title %}{{ item.title | striptags }} // {{app.title }}{% endblock title %}
{% block description %}{{ item.intro | default(value="") }}{% endblock description %}

{% block content %}

    {# BREADCRUMB #}
    <div class="text-[11px] text-zinc-600 tracking-wider mb-8 flex items-center gap-2">
        <a data-spa href="/{{ lang }}" class="hover:text-zinc-400 transition-colors">~</a>
        <span>/</span>
        <a data-spa href="/{{ lang }}/{{ type_name }}" class="hover:text-zinc-400 transition-colors">posts</a>
        <span>/</span>
        <span class="text-[#00e5a0]">{{ item.id }}</span>
    </div>

    {# FRONT MATTER HEADER #}
    <header class="mb-12 border-b border-zinc-800 pb-8">

        {# Badge categoria + feature #}
        <div class="flex items-center gap-3 mb-4 flex-wrap">
            {% if item.category %}
                <span class="text-[10px] text-[#ffb347] border border-[#ffb347]/40 px-2 py-1 tracking-widest uppercase">
            {{ item.category }}
        </span>
            {% endif %}
            {% if item.feature_name %}
                <span class="text-[10px] text-zinc-500 border border-zinc-700 px-2 py-1 tracking-widest uppercase">
            {{ item.feature_name }}
        </span>
            {% endif %}
            {% if item.has_errors %}
                <span class="text-[10px] text-red-400 border border-red-400/40 px-2 py-1 tracking-widest uppercase">
            ⚠ has_errors
        </span>
            {% endif %}
        </div>

        {# Titolo #}
        <h1 class="text-3xl md:text-5xl font-bold tracking-tighter text-zinc-100 leading-tight mb-4 glitch"
            data-glitch="{{ item.title }}">
            {{ item.title | safe }}
        </h1>

        {# Meta: data, env_id #}
        <div class="flex items-center gap-4 text-xs text-zinc-500 tracking-wider">
            <span>{{ item.created }}</span>
            {% if item.env_id %}
                <span class="text-zinc-700">·</span>
                <span class="text-zinc-600">env_{{ item.env_id }}</span>
            {% endif %}
        </div>

        {# Intro #}
        {% if item.intro %}
            <p class="mt-6 text-zinc-400 text-sm leading-relaxed max-w-2xl border-l-2 border-[#00e5a0]/40 pl-4">
                {{ item.intro }}
            </p>
        {% endif %}

    </header>

    {# ERROR DESCRIPTION #}
    {% if item.has_errors and item.error_description %}
        <div class="mb-8 border border-red-500/30 bg-red-950/20 p-4 text-xs">
            <div class="text-red-400 tracking-widest uppercase mb-2 text-[10px]">// error_log</div>
            <p class="text-red-300/80 leading-relaxed">{{ item.error_description }}</p>
        </div>
    {% endif %}

    {# BODY FIELDS #}
    <article class="space-y-6 mb-16">
        {% if item.body_fields %}
            {% for field in item.body_fields %}
                {{ render_field(field=field, type=field.type) | safe }}
            {% endfor %}
        {% endif %}

        {# Fallback: raw content (if exists and if body_fields are empty) #}
        {% if item.content and not item.body_fields %}
            <div class="prose prose-invert prose-sm max-w-none text-zinc-300 leading-relaxed">
                {{ item.content | safe }}
            </div>
        {% endif %}
    </article>

    {# REFLECTION #}
    {% if item.reflection %}
        <aside class="border border-zinc-800 bg-zinc-900/30 p-6 mt-10">
            <div class="text-[10px] text-zinc-600 tracking-widest uppercase mb-3">// reflection</div>
            <p class="text-zinc-400 text-sm leading-relaxed italic">{{ item.reflection | safe }}</p>
        </aside>
    {% endif %}

    {# NAVIGAZIONE POST #}
    <nav class="mt-12 pt-6 border-t border-zinc-800 text-xs text-zinc-500 tracking-wider"
         aria-label="Navigazione tra contenuti">

        {% if enable_navigation and prev_item[0] %}
            {# Three columns layout: prev | back | next #}
            <div class="grid grid-cols-3 items-start gap-4">

                {# Prev #}
                <a data-spa href="{{ prev_item[0] }}"
                   class="group flex flex-col gap-1 hover:text-[#00e5a0] transition-colors min-w-0">
                    <span class="text-zinc-700 group-hover:text-[#00e5a0] transition-colors">← prev</span>
                    <span class="text-[11px] text-zinc-600 group-hover:text-zinc-400 transition-colors truncate">
                {{ prev_item[1] | safe }}
            </span>
                </a>

                {# Back to index - center #}
                <a data-spa href="/{{ lang }}/{{ type_name }}"
                   class="flex justify-center items-center hover:text-[#00e5a0] transition-colors pt-0.5">
                    {{ t(key="nav.index", lang=lang) }}
                </a>

                {# Next #}
                <a data-spa href="{{ next_item[0] }}"
                   class="group flex flex-col gap-1 items-end hover:text-[#00e5a0] transition-colors min-w-0 text-right">
                    <span class="text-zinc-700 group-hover:text-[#00e5a0] transition-colors">{{ t(key="nav.next", lang=lang) }}</span>
                    <span class="text-[11px] text-zinc-600 group-hover:text-zinc-400 transition-colors truncate">
                {{ next_item[1] | safe }}
            </span>
                </a>

            </div>
        {% else %}
            {# Simple navigation - without prev/next #}
            <div class="flex justify-between">
                <a data-spa href="/{{ lang }}/{{ type_name }}" class="hover:text-[#00e5a0] transition-colors">{{ t(key="nav.back_to_posts", lang=lang) }}</a>
                <a data-spa href="/{{ lang }}"                 class="hover:text-[#00e5a0] transition-colors">{{ t(key="nav.home", lang=lang) }}</a>
            </div>
        {% endif %}

    </nav>

{% endblock content %}
